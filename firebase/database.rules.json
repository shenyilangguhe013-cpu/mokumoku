{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "auth != null && $room.matches(/^[A-Za-z0-9_-]{6,32}$/)",
        "members": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $room.matches(/^[A-Za-z0-9_-]{6,32}$/)",
            ".validate": "newData.hasChildren(['name', 'status', 'updatedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 12" },
            "status": { ".validate": "newData.val() == 'studying' || newData.val() == 'idle'" },
            "startedAt": { ".validate": "newData.isNumber()" },
            "date": { ".validate": "newData.isString() && newData.val().length == 10" },
            "todayMinutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
            "weekKey": { ".validate": "newData.isString() && newData.val().length == 10" },
            "weekMinutes": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10080" },
            "updatedAt": { ".validate": "newData.isNumber()" },
            "$other": { ".validate": false }
          }
        }
      }
    }
  }
}
